{
  "name": "r-reader",
  "version": "0.4.6",
  "description": "Polished EPUB reader for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "build:css": "node build-css.mjs",
    "test": "vitest run",
    "harness": "node dev/build-harness.mjs && node e2e/serve.mjs",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "deploy": "node esbuild.config.mjs production && cp main.js manifest.json styles.css \"/Users/anhv/Documents/Vault/.obsidian/plugins/r-reader/\""
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "happy-dom": "^20.14.6",
    "obsidian": "latest",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
